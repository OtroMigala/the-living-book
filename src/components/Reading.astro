---
// Reading mode (F10): the whole book as one article, in the initial HTML. Each block has an id that
// is the same in both languages (K02 parity), so the language switch can land on the same paragraph.
import { loadBook } from '../content/load.ts';
import type { Locale } from '../content/model.ts';
import { blockId, UI } from '../i18n/ui.ts';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const book = loadBook(locale);
const ui = UI[locale];
---

<Base
  title={`${book.title}: ${book.subtitle} · ${ui.siteTitle}`}
  description={book.description}
  locale={locale}
  page="home"
>
  <p class="notice" role="note">{ui.notice}</p>
  <article class="reading">
    <header>
      <h1>{book.title}</h1>
      <p class="subtitle">{book.subtitle}</p>
    </header>
    {
      book.chapters.map((chapter) => (
        <section aria-labelledby={`chapter-${chapter.id}`}>
          <h2 id={`chapter-${chapter.id}`}>{chapter.title}</h2>
          {chapter.blocks.map((block, i) =>
            block.type === 'heading' ? (
              <h3 id={blockId(chapter.id, i)} data-block>
                {block.text}
              </h3>
            ) : (
              <p id={blockId(chapter.id, i)} data-block>
                {block.text}
              </p>
            ),
          )}
        </section>
      ))
    }
  </article>
</Base>

<script>
  // Progressive enhancement: without JavaScript the switch opens the other language at the top.
  // With it, the link points at the paragraph the reader is on, whose id is the same in both
  // languages: the first one that starts below the sticky header. If none starts there (one long
  // paragraph fills the window), the one that started above it.
  const link = document.querySelector<HTMLAnchorElement>('[data-switch-locale]');
  link?.addEventListener('click', () => {
    if (window.scrollY === 0) return;
    const headerBottom = document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0;
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-block]')];
    const startsBelow = blocks.find((b) => b.getBoundingClientRect().top >= headerBottom - 2);
    const startedAbove = blocks.filter((b) => b.getBoundingClientRect().top < headerBottom).at(-1);
    const current =
      startsBelow && startsBelow.getBoundingClientRect().top < window.innerHeight
        ? startsBelow
        : startedAbove;
    if (current) link.hash = current.id;
  });
</script>
