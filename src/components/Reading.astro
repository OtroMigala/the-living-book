---
// Reading mode (F10): the whole book as one article, in the initial HTML. Each block has an id that
// is the same in both languages (K02 parity), so the language switch can land on the same paragraph.
import { loadBook } from '../content/load.ts';
import type { Locale } from '../content/model.ts';
import { UI } from '../i18n/ui.ts';
import Base from '../layouts/Base.astro';
import ReadingArticle from './ReadingArticle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const book = loadBook(locale);
const ui = UI[locale];
---

<Base
  title={`${book.title}: ${book.subtitle} · ${ui.siteTitle}`}
  description={book.description}
  locale={locale}
  page="home"
>
  <p class="notice" role="note">{ui.notice}</p>
  <ReadingArticle book={book} />
</Base>

<script>
  // Progressive enhancement: without JavaScript the links open the other language, or the book, at
  // the start. With it, they point at the paragraph the reader is on, whose id is the same in both
  // languages and in the book: the first one that starts below the sticky header. If none starts
  // there (one long paragraph fills the window), the one that started above it.
  const currentBlock = () => {
    if (window.scrollY === 0) return null;
    const headerBottom = document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0;
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-block]')];
    const startsBelow = blocks.find((b) => b.getBoundingClientRect().top >= headerBottom - 2);
    const startedAbove = blocks.filter((b) => b.getBoundingClientRect().top < headerBottom).at(-1);
    return startsBelow && startsBelow.getBoundingClientRect().top < window.innerHeight
      ? startsBelow
      : (startedAbove ?? null);
  };
  const languageLink = document.querySelector<HTMLAnchorElement>('[data-switch-locale]');
  languageLink?.addEventListener('click', () => {
    const current = currentBlock();
    if (current) languageLink.hash = current.id;
  });
  // F09 AC2: from the reading mode to the book, at the same place (the reader reads #at=<id>).
  const bookLink = document.querySelector<HTMLAnchorElement>('[data-book-link]');
  bookLink?.addEventListener('click', () => {
    const current = currentBlock();
    if (current) bookLink.hash = `at=${current.id}`;
  });
</script>
