---
// The book as pages (Stage 4, step 5b): the 2D reader. Its initial HTML is the reading article
// (F10, F15), what one reads without JavaScript; the script turns it into pages with the breaks
// the build measured (ADR 0009). Not linked and not indexed while it is being built.
import { loadBook } from '../content/load.ts';
import { HTML_LANG, type Locale } from '../content/model.ts';
import { otherLocale, ROUTES, UI } from '../i18n/ui.ts';
import Base from '../layouts/Base.astro';
import ReadingArticle from './ReadingArticle.astro';
import '../styles/page.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const book = loadBook(locale);
const ui = UI[locale];
const other = otherLocale(locale);
const base = import.meta.env.BASE_URL;
const config = {
  locale,
  otherLocale: other,
  otherHref: `${base}${ROUTES[other].book}`,
  otherLang: HTML_LANG[other],
  articleHref: `${base}${ROUTES[locale].home}`,
  creditsHref: `${base}${ROUTES[locale].credits}`,
  base,
  text: {
    pageOf: ui.pageOf,
    pagesOf: ui.pagesOf,
    pageLabel: ui.pageLabel,
    contents: ui.contents,
    otherWays: ui.otherWays,
    readAsArticle: ui.readAsArticle,
    flatPages: ui.flatPages,
    book3d: ui.book3d,
    credits: ui.credits,
    switchTo: ui.switchTo,
    switchToLabel: ui.switchToLabel,
    continueAt: ui.continueAt,
    hintKeys: ui.hintKeys,
    hintLook: ui.hintLook,
    hintTouch: ui.hintTouch,
  },
  modeText: {
    lost: ui.contextLost,
    slow: ui.slow3d,
    toFlat: ui.toFlat,
    keep3d: ui.keep3d,
  },
};
---

<Base
  title={`${book.title} · ${ui.bookTitle} · ${ui.siteTitle}`}
  description={book.description}
  locale={locale}
  page="book"
  noindex
>
  <ReadingArticle book={book} id="book-article" />
  <div
    class="load-progress"
    id="book-progress"
    role="progressbar"
    aria-label={ui.loading3d}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    hidden
  >
    <span></span>
  </div>
  <div class="reader" id="reader" hidden>
    <div class="desk" id="reader-desk">
      <div class="view" id="reader-view"></div>
      <canvas id="reader-canvas" role="img" aria-label={ui.deskLabel}></canvas>
      <div class="atmosphere" aria-hidden="true"></div>
      <div class="pages3d" id="reader-pages"></div>
      <div class="layout3d" id="reader-layout" aria-hidden="true"></div>
    </div>
    <nav class="reader-bar" aria-label={ui.pagesNav}>
      <div class="pager">
        <button type="button" class="turn" id="reader-prev" aria-label={ui.previous} title={ui.previous}>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>
        <p id="reader-where" aria-live="polite"></p>
        <button type="button" class="turn" id="reader-next" aria-label={ui.next} title={ui.next}>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
      <p id="reader-note" role="status"></p>
      <output id="reader-debug" hidden></output>
    </nav>
    <div class="measure" id="reader-measure" aria-hidden="true"></div>
  </div>
  <script type="application/json" id="reader-config" set:html={JSON.stringify(config)} />
</Base>

<style is:global>
  /* While the pages are shown they fill the window; the site's header and footer step aside (the
     book's contents page carries their links, F18). Without JavaScript nothing changes. Hidden, not
     removed: removing the header moved <main> up under the reader, and the browser counts that
     as a layout shift (CLS 0.079 on Lighthouse mobile, over BL2) although nobody can see it. */
  body:has(#reader:not([hidden])) .site-header,
  body:has(#reader:not([hidden])) .site-footer {
    visibility: hidden;
  }
  /* F15 AC2: the 3D view's bytes as they arrive, a line on top of the article. Fixed, so it moves
     nothing (BL2). */
  .load-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 7;
    height: 3px;
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .load-progress[hidden] {
    display: none;
  }
  .load-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
    transition: transform 150ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .load-progress span {
      transition: none;
    }
  }
  /* F10 AC2: printed, the book is the whole article, without the desk, the pages or the bar. */
  @media print {
    #reader {
      display: none !important;
    }
    #book-article[hidden] {
      display: block;
    }
  }
</style>

<style>
  .reader {
    position: fixed;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    background: var(--desk);
  }
  .reader[hidden] {
    display: none;
  }
  .desk {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  /* One view or the other (reader.ts): flat pages, or the 3D desk with the pages over it. */
  .reader[data-mode="3d"] .view,
  .reader[data-mode="2d"] #reader-canvas,
  .reader[data-mode="2d"] .pages3d {
    display: none;
  }
  /* An old room's air (spike D): the edges of the desk in shadow, over the 3D desk and under the
     pages' text. The middle stays clear, so the scene keeps its colours where one looks (a grain
     over everything made them paler, measured). The browser composites it: nothing per frame. */
  .atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 45%, transparent 50%, rgb(18 10 4 / 0.6) 100%);
  }
  .reader[data-mode="2d"] .atmosphere {
    display: none;
  }
  #reader-canvas {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    /* A drag on the desk tilts the book (F16); the browser must not scroll or zoom instead. */
    touch-action: none;
  }
  .pages3d {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* The HTML pages over the 3D pages: transparent, because the 3D page is the paper. */
  .pages3d :global(.page) {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    pointer-events: auto;
  }
  /* The grips on the pages' outer edges (F02): inside the margin, never over text. */
  .reader :global(.grip) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 20px;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .reader :global(.grip[data-step="1"]) {
    right: 0;
  }
  .reader :global(.grip[data-step="-1"]) {
    left: 0;
  }
  .pages3d :global(.corner) {
    position: absolute;
    width: 0;
    height: 0;
  }
  .pages3d :global([data-corner="tl"]) {
    left: 0;
    top: 0;
  }
  .pages3d :global([data-corner="tr"]) {
    left: 100%;
    top: 0;
  }
  .pages3d :global([data-corner="br"]) {
    left: 100%;
    top: 100%;
  }
  .pages3d :global([data-corner="bl"]) {
    left: 0;
    top: 100%;
  }
  .layout3d {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    pointer-events: none;
  }
  /* The view keeps its full size for measuring; a page class too big for it is scaled down, a
     plain 2D scale that the browser draws as sharp text. */
  .view {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    transform: scale(var(--scale, 1));
  }
  .view :global(.page) {
    flex: none;
    background: #f7f1e3;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.4);
  }
  /* The fold between the two pages of a spread. */
  .view[data-pages="2"] :global(.page:first-child) {
    background-image: linear-gradient(to left, rgb(0 0 0 / 0.12), transparent 24px);
  }
  .view[data-pages="2"] :global(.page:last-child) {
    background-image: linear-gradient(to right, rgb(0 0 0 / 0.12), transparent 24px);
  }
  /* F18: no bar over the desk; the book's own pages carry the links (the contents page). What is
     left floats over the desk only when it is needed: the turn buttons wait out of sight at its
     edges until the keyboard reaches them (Q05 AC2), the page's number is read out to screen
     readers only, and a message shows while it has something to say. */
  .reader-bar {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--desk-ink);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
  .turn {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    padding: 0;
    border: 1px solid var(--desk-rule);
    border-radius: 50%;
    background: var(--desk);
    color: var(--desk-ink);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.4);
    cursor: pointer;
    pointer-events: auto;
  }
  #reader-prev {
    left: var(--space-2);
  }
  #reader-next {
    right: var(--space-2);
  }
  .turn path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .turn:focus-visible {
    outline: 2px solid var(--desk-accent);
    outline-offset: 2px;
  }
  /* Out of sight, still in the accessibility tree and in the keyboard's order. */
  .turn:not(:focus-visible),
  #reader-where,
  #reader-note:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* A message floats over the desk, near its foot, so the pages keep their size (F01 AC1). */
  #reader-note:not(:empty) {
    position: absolute;
    bottom: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 2 * var(--space-3));
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--desk-rule);
    border-radius: 6px;
    background: var(--desk);
    color: var(--desk-ink);
    text-align: center;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.4);
    pointer-events: auto;
  }
  /* Made by the script, so outside this component's scoped styles: hence :global. */
  #reader-note :global(button) {
    margin-left: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--desk-accent);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  #reader-note :global(button:focus-visible) {
    outline: 2px solid var(--desk-accent);
    outline-offset: 2px;
  }
  /* ?debug=1 only: measurements in a line at the desk's foot. */
  #reader-debug {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-1);
    margin: 0;
    text-align: center;
    color: var(--desk-ink-muted);
  }
  .measure {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
  import {
    type Reader,
    type ReaderOptions,
    type ReaderView,
    startReader,
  } from '../reader/reader.ts';
  import { ByteProgress } from '../reader/progress.ts';
  import { createView2d } from '../reader/view2d.ts';
  import { readDevice } from '../three/device.ts';
  import { type Tier, tierFor } from '../three/tiers.ts';

  const get = (id: string) => document.getElementById(id);
  /** How long the note that the 3D view stopped stays over the pages, ms. */
  const LOST_NOTE_MS = 10_000;
  const root = get('reader');
  const desk = get('reader-desk');
  const view = get('reader-view');
  const canvas = get('reader-canvas');
  const pages = get('reader-pages');
  const layout = get('reader-layout');
  const measure = get('reader-measure');
  const prev = get('reader-prev');
  const next = get('reader-next');
  const where = get('reader-where');
  const article = get('book-article');
  const config = get('reader-config');

  // ?debug=1 shows measurements on a device without developer tools: the last turn's frame times
  // (BR1), and the long tasks since the first paint. A long task blocks input for what it lasts
  // beyond 50 ms, and those excesses are what Lighthouse's TBT adds up (BL3). Chromium reports
  // long tasks, Firefox and WebKit do not. Observed from here, before the 3D view starts.
  const debugging = new URLSearchParams(location.search).get('debug') === '1';
  const reportsLongTasks = PerformanceObserver.supportedEntryTypes?.includes('longtask') ?? false;
  const longTasks: { start: number; duration: number }[] = [];
  if (debugging && reportsLongTasks) {
    new PerformanceObserver((list) => {
      for (const task of list.getEntries()) {
        longTasks.push({ start: task.startTime, duration: task.duration });
      }
    }).observe({ type: 'longtask', buffered: true });
  }
  const longTaskSummary = () => {
    if (!reportsLongTasks) return 'long tasks: not reported here';
    const painted = performance.getEntriesByName('first-contentful-paint')[0]?.startTime ?? 0;
    const after = longTasks.filter((task) => task.start >= painted);
    const blocking = after.reduce((ms, task) => ms + task.duration - 50, 0);
    const longest = Math.max(0, ...after.map((task) => task.duration));
    return (
      `since first paint: ${after.length} long task${after.length === 1 ? '' : 's'}, ` +
      `${Math.round(blocking)} ms blocking, ` +
      `longest ${Math.round(longest)} ms`
    );
  };

  /**
   * Resolves once the page has loaded (its fonts included) and the browser reports that it painted
   * it (Paint Timing). Counting animation frames instead left the 3D download starting 0–6 ms after
   * the paint, or before it. A page opened in a background tab gets no report, so a second after
   * the load stands in for it. Not awaited at the module's top level, so it can never hold up the
   * load event it waits for.
   */
  const afterFirstPaint = () =>
    new Promise<void>((resolve) => {
      const painted = () => performance.getEntriesByName('first-contentful-paint').length > 0;
      let done = false;
      const finish = () => {
        done = true;
        resolve();
      };
      const check = () => {
        if (done) return;
        if (painted()) finish();
        else requestAnimationFrame(check);
      };
      const loaded = () => {
        check();
        setTimeout(finish, 1000);
      };
      if (document.readyState === 'complete') loaded();
      else addEventListener('load', loaded, { once: true });
    });

  async function start() {
    if (
      root &&
      desk &&
      view &&
      canvas instanceof HTMLCanvasElement &&
      pages &&
      layout &&
      measure &&
      prev instanceof HTMLButtonElement &&
      next instanceof HTMLButtonElement &&
      where &&
      article &&
      config
    ) {
      const options = JSON.parse(config.textContent ?? '{}') as ReaderOptions & {
        modeText: {
          lost: string;
          slow: string;
          toFlat: string;
          keep3d: string;
        };
      };
      // F09: the 3D desk where the browser can draw it, else flat pages, and a switch between the
      // two that keeps the place; the article is one link away. ?mode=2d starts with flat pages.
      let view3d: ReaderView | null = null;
      let view2d: ReaderView | null = null;
      let reader: Reader | null = null;
      let lost = false;
      const flat = () => {
        view2d ??= createView2d(view);
        return view2d;
      };
      const note = get('reader-note');
      // F09 AC1: when the browser takes the GPU context away, the book goes on flat, at the same
      // place, and says so; the 3D view is not offered again until the page is loaded again (the
      // contents page offers the other view only while there is one, F18).
      const onContextLost = () => {
        lost = true;
        view3d = null;
        if (note) {
          note.textContent = options.modeText.lost;
          // Said, and announced (role="status"); then it leaves the pages (F18 AC3).
          setTimeout(() => {
            if (note.textContent === options.modeText.lost) note.replaceChildren();
          }, LOST_NOTE_MS);
        }
        if (reader) void reader.useView(flat());
      };
      // F09 AC3: the 3D view too slow here: offer flat pages, with a choice; never switch alone.
      const onSlow = () => {
        if (!note || reader?.state.mode !== '3d') return;
        const choice = (label: string, action: () => Promise<void>) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = label;
          button.addEventListener('click', async () => {
            note.replaceChildren();
            await action();
          });
          return button;
        };
        note.replaceChildren(
          `${options.modeText.slow} `,
          choice(options.modeText.toFlat, async () => {
            await reader?.useView(flat());
          }),
          choice(options.modeText.keep3d, async () => {}),
        );
      };
      // F15 AC2: a line on top of the article shows the 3D view's bytes as they arrive: the code
      // files when each completes (Resource Timing), the model as it streams in. The build lists
      // them with their sizes, for each tier, since each tier loads its own model; without that
      // list, there is no line.
      const bar = get('book-progress');
      let progress: ByteProgress | null = null;
      // Once the view is ready the line is gone for good: files that arrive later (the page
      // breaks, for one) report too, and must not bring it back.
      let loaded = false;
      const showProgress = (share: number) => {
        if (!bar || loaded) return;
        bar.hidden = false;
        bar.setAttribute('aria-valuenow', String(Math.round(share * 100)));
        bar.style.setProperty('--progress', String(share));
      };
      const listed = (path: string) => {
        if (progress) showProgress(progress.done(path));
      };
      const onModelProgress = (path: string, loaded: number) => {
        if (progress) showProgress(progress.report(path, loaded));
      };
      const wants3d = new URLSearchParams(location.search).get('mode') !== '2d';
      if (wants3d) {
        void fetch(`${options.base}pages/book-bytes.json`)
          .then((response) => (response.ok ? response.json() : null))
          .then((listing: Record<Tier, Record<string, number>> | null) => {
            const files = listing?.[tierFor(readDevice())];
            if (!files) return;
            progress = new ByteProgress(files);
            showProgress(progress.share);
            new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) listed(new URL(entry.name).pathname);
            }).observe({ type: 'resource', buffered: true });
          })
          .catch(() => {});
      }
      // three.js is loaded only for the 3D view, after the article is on screen (F15). Started any
      // earlier, its download began before the article's first paint and competed with the article
      // for a slow network: Lighthouse's mobile LCP went from 1.65 s to 4.65 s in 2 of 3 CI runs.
      if (wants3d) {
        view3d = await import('../reader/view3d.ts')
          .then(({ createView3d }) =>
            createView3d({ stage: desk, canvas, pages, layout }, options.base, {
              onContextLost,
              onSlow,
              onModelProgress,
            }),
          )
          .catch(() => null);
      }
      const firstView = view3d ?? flat();
      root.dataset.mode = firstView.mode;
      // The 3D view ready, all it needed has arrived; flat pages need none of it. The line goes.
      if (progress && view3d) showProgress(progress.complete());
      loaded = true;
      if (bar) bar.hidden = true;
      const debugOut = get('reader-debug');
      if (debugOut && debugging) {
        debugOut.hidden = false;
        setInterval(() => {
          const turn = window.__view3d?.lastTurn;
          const turned = turn
            ? `${turn.direction}: ${turn.frames} frames, p50 ${turn.p50} ms, p95 ${turn.p95} ms, max ${turn.max} ms, paint ${turn.paintMs} ms`
            : `${reader?.state.mode ?? firstView.mode}: turn a page`;
          debugOut.textContent = `${longTaskSummary()} · ${turned}`;
        }, 500);
      }
      reader = await startReader(
        {
          root,
          view: firstView,
          measure,
          prev,
          next,
          where,
          article,
        },
        { ...options, canSwitchView: () => view3d !== null },
      );
      if (lost) await reader.useView(flat());
      // F09, F18: the contents page's switch between flat pages and the 3D book.
      root.addEventListener('click', async (event) => {
        if (!reader || !(event.target as HTMLElement).closest('[data-reader-mode]')) return;
        note?.replaceChildren();
        const other = reader.state.mode === '3d' ? flat() : view3d;
        if (other) await reader.useView(other);
      });
    }
  }
  void afterFirstPaint().then(start);
</script>
