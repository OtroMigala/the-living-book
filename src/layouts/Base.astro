---
// Every page: language, title and description (Q06), skip link and landmarks (Q05), and the
// language switch with hreflang alternates (F13).
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
// The URL Vite gives the regular font file, so it can be preloaded (see fonts.css).
import literataRegular from '../../node_modules/@fontsource/literata/files/literata-latin-400-normal.woff2?url';
import type { Locale } from '../content/model.ts';
import { HTML_LANG } from '../content/model.ts';
import { otherLocale, type PageKey, ROUTES, UI } from '../i18n/ui.ts';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** The page this is, so the switch can point to the same page in the other language. */
  page?: PageKey;
  noindex?: boolean;
}

const { title, description, locale, page, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const ui = UI[locale];
const other = otherLocale(locale);
const href = (l: Locale, p: PageKey) => `${base}${ROUTES[l][p]}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={literataRegular} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      page && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(href('en-us', page), Astro.site)} />
          <link rel="alternate" hreflang="es-419" href={new URL(href('es-419', page), Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(href('en-us', page), Astro.site)} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipLink}</a>
    <header class="site-header">
      <a class="site-title" href={href(locale, 'home')}>{ui.siteTitle}</a>
      <nav aria-label={ui.navLabel}>
        <ul>
          <li><a href={href(locale, 'home')}>{ui.read}</a></li>
          <li><a href={href(locale, 'credits')}>{ui.credits}</a></li>
          {
            page && (
              <li>
                <a
                  href={href(other, page)}
                  hreflang={HTML_LANG[other]}
                  lang={HTML_LANG[other]}
                  aria-label={ui.switchToLabel}
                  data-switch-locale
                >
                  {ui.switchTo}
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {ui.footer} <a href={href(locale, 'credits')}>{ui.footerLink}</a>
        {ui.footerEnd}
      </p>
    </footer>
  </body>
</html>
