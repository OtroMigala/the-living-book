---
// Every page: language, title and description (Q06), skip link and landmarks (Q05).
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
// The URL Vite gives the regular font file, so it can be preloaded (see fonts.css).
import literataRegular from '../../node_modules/@fontsource/literata/files/literata-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang: string;
  noindex?: boolean;
}

const { title, description, lang, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={literataRegular} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the text</a>
    <header class="site-header">
      <a class="site-title" href={base}>The Living Book</a>
      <nav aria-label="Site">
        <ul>
          <li><a href={base}>Read</a></li>
          <li><a href={`${base}credits/`}>Credits</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        A pilot project, built in stages. Code under the MIT License;
        <a href={`${base}credits/`}>credits and licenses</a> of the text and the model.
      </p>
    </footer>
  </body>
</html>
